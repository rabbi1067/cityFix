# Copy to application-local.properties in the project root for local development.
# The real file is ignored by Git/Docker. Do not commit real secrets.
DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=replace-with-your-database-password
SUPER_ADMIN_EMAIL=replace-with-your-super-admin-email
SUPER_ADMIN_PASSWORD=replace-with-your-super-admin-password
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
MAIL_USERNAME=replace-with-your-email
MAIL_PASSWORD=replace-with-your-app-password
